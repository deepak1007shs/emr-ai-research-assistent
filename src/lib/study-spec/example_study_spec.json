{
  "spec_version": "1.0.0",
  "study": {
    "title": "Effect of structured nutritional and psychological prehabilitation on postoperative complications after elective pancreaticoduodenectomy: an open-label, assessor-blinded randomised controlled trial",
    "design": "rct_parallel",
    "design_detail": {
      "unit_of_allocation": "individual",
      "allocation_ratio": "1:1",
      "sequence_generation": "Computer-generated block randomisation, block size 4, by an independent statistician",
      "allocation_concealment": "Sequentially numbered opaque sealed envelopes, opened after enrolment",
      "blinding": "Outcome assessors and data analysts blinded; participants and surgeons not blinded"
    },
    "framework": "PICO",
    "guideline": "CONSORT",
    "setting": "hospital_based",
    "centres": 1,
    "recruitment_period": {
      "start": "2026-09-01",
      "end": "2027-11-30"
    },
    "population": "Adults aged 18 years or over scheduled for elective pancreaticoduodenectomy for resectable periampullary or pancreatic head tumours",
    "groups": [
      {
        "id": "grp_intervention",
        "label": "Prehabilitation plus standard ERAS",
        "allocation_ratio": "1"
      },
      {
        "id": "grp_control",
        "label": "Standard ERAS alone",
        "allocation_ratio": "1"
      }
    ],
    "claim_strength": "causal"
  },
  "timepoints": [
    {
      "id": "tp_screen",
      "label": "Screening",
      "order": 1,
      "window": "day of eligibility assessment",
      "offset_days": -30
    },
    {
      "id": "tp_baseline",
      "label": "Baseline (4 weeks before surgery)",
      "order": 2,
      "window": "-28 days ± 5",
      "offset_days": -28
    },
    {
      "id": "tp_surgery",
      "label": "Day of surgery",
      "order": 3,
      "window": "day 0",
      "offset_days": 0
    },
    {
      "id": "tp_d30",
      "label": "Day 30 after surgery",
      "order": 4,
      "window": "day 30 ± 3",
      "offset_days": 30
    }
  ],
  "eligibility": {
    "inclusion": [
      {
        "id": "elg_inc_age",
        "text": "Aged 18 years or over",
        "numeric": {
          "variable_id": "var_age",
          "min": 18
        }
      },
      {
        "id": "elg_inc_elective",
        "text": "Scheduled for elective pancreaticoduodenectomy",
        "variable_id": "var_procedure"
      },
      {
        "id": "elg_inc_asa",
        "text": "ASA physical status I or II",
        "numeric": {
          "variable_id": "var_asa_numeric",
          "min": 1,
          "max": 2
        }
      },
      {
        "id": "elg_inc_consent",
        "text": "Able and willing to give written informed consent",
        "variable_id": "var_consent"
      }
    ],
    "exclusion": [
      {
        "id": "elg_exc_asa",
        "text": "ASA physical status III or above",
        "numeric": {
          "variable_id": "var_asa_numeric",
          "min": 3
        }
      },
      {
        "id": "elg_exc_unresectable",
        "text": "Unresectable disease on staging",
        "variable_id": "var_resectable"
      },
      {
        "id": "elg_exc_psych",
        "text": "Major psychiatric disorder or severe cognitive impairment",
        "variable_id": "var_psych_exclusion"
      }
    ]
  },
  "objectives": [
    {
      "id": "obj_primary",
      "tier": "primary",
      "question": "In adults undergoing elective pancreaticoduodenectomy, does a four-week structured nutritional and psychological prehabilitation programme added to standard ERAS reduce the proportion of patients with a Clavien-Dindo grade II or higher complication within 30 days of surgery, compared with standard ERAS alone?",
      "outcome_ids": [
        "out_complication"
      ],
      "comparison_type": "superiority",
      "estimand": {
        "treatment_condition": "Four-week structured nutritional and psychological prehabilitation added to standard ERAS, versus standard ERAS alone",
        "population": "All randomised participants who underwent surgery (modified intention-to-treat)",
        "endpoint": "Any Clavien-Dindo grade II or higher complication within 30 days of surgery",
        "intercurrent_event_strategy": "treatment_policy",
        "population_level_summary": "Risk difference and risk ratio with 95% confidence intervals"
      }
    },
    {
      "id": "obj_secondary_los",
      "tier": "secondary",
      "question": "Does prehabilitation shorten postoperative length of hospital stay?",
      "outcome_ids": [
        "out_los"
      ],
      "comparison_type": "superiority"
    },
    {
      "id": "obj_exploratory_anxiety",
      "tier": "exploratory",
      "question": "Does prehabilitation change preoperative anxiety, as a mechanism check?",
      "outcome_ids": [
        "out_anxiety"
      ],
      "comparison_type": "none"
    }
  ],
  "outcomes": [
    {
      "id": "out_complication",
      "label": "Clavien-Dindo grade II or higher complication within 30 days",
      "tier": "primary",
      "definition": "Any postoperative complication of Clavien-Dindo grade II or above occurring within 30 days of surgery",
      "instrument": "Clavien-Dindo classification, assessed by a blinded assessor from the case record",
      "timepoint_id": "tp_d30",
      "data_type": "binary",
      "subtype": "dichotomous, patient level",
      "summary_statistic": "proportion",
      "domain": "clinical event",
      "source_variable_ids": [
        "var_complication_binary"
      ]
    },
    {
      "id": "out_los",
      "label": "Postoperative length of hospital stay",
      "tier": "secondary",
      "definition": "Whole days from date of surgery to date of discharge alive",
      "instrument": "Hospital admission record",
      "timepoint_id": "tp_d30",
      "data_type": "continuous",
      "subtype": "ratio scale, right-skewed",
      "unit": "days",
      "summary_statistic": "median (IQR)",
      "domain": "resource use",
      "source_variable_ids": [
        "var_length_of_stay"
      ]
    },
    {
      "id": "out_anxiety",
      "label": "Preoperative anxiety score",
      "tier": "exploratory",
      "definition": "GAD-7 total score at the preoperative visit",
      "instrument": "GAD-7 questionnaire, self-completed",
      "timepoint_id": "tp_surgery",
      "data_type": "continuous",
      "subtype": "interval scale, 0 to 21",
      "unit": "points",
      "summary_statistic": "mean (SD)",
      "domain": "patient reported",
      "source_variable_ids": [
        "var_gad7_total"
      ]
    }
  ],
  "variables": [
