{
  "$comment": "The contract for study_spec.json. Read by validate_study_spec.js Layer 1. Uses a deliberately small JSON-Schema subset: type, enum, required, properties, items, additionalProperties, pattern, minItems. RULE: where a Layer 2 invariant has a materially better message than 'required property is missing', Layer 1 checks only the type and the invariant owns the requirement — otherwise the shape layer fires first and the useful message is never seen. Those cases are marked $ownedBy.",
  "type": "object",
  "required": [
    "spec_version",
    "study",
    "timepoints",
    "eligibility",
    "objectives",
    "outcomes",
    "variables",
    "analyses",
    "tables",
    "crf_sections",
    "sample_size"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "locked_at": {
      "type": "string"
    },
    "study": {
      "type": "object",
      "required": [
        "title",
        "design",
        "design_detail",
        "framework",
        "guideline",
        "setting",
        "population"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "design": {
          "type": "string",
          "enum": [
            "rct_parallel",
            "rct_crossover",
            "rct_cluster",
            "rct_factorial",
            "rct_stepped_wedge",
            "rct_non_inferiority",
            "rct_pilot",
            "n_of_1",
            "non_randomised_trial",
            "single_arm",
            "before_after",
            "interrupted_time_series",
            "cohort_prospective",
            "cohort_retrospective",
            "cohort_ambidirectional",
            "case_control",
            "case_control_nested",
            "case_cohort",
            "cross_sectional_analytical",
            "cross_sectional_descriptive",
            "case_report",
            "case_series",
            "ecological",
            "case_crossover",
            "self_controlled_case_series",
            "diagnostic_accuracy",
            "prognostic_model",
            "reliability_agreement",
            "economic_evaluation",
            "pk_bioequivalence",
            "instrument_validation",
            "qualitative",
            "mixed_methods",
            "systematic_review",
            "scoping_review"
          ]
        },
        "design_detail": {
          "type": "object"
        },
        "framework": {
          "type": "string",
          "enum": [
            "PICO",
            "PECO",
            "PIRT"
          ]
        },
        "guideline": {
          "type": "string",
          "enum": [
            "CONSORT",
            "SPIRIT",
            "TREND",
            "STROBE",
            "RECORD",
            "STARD",
            "TRIPOD",
            "GRRAS",
            "COREQ",
            "SRQR",
            "GRAMMS",
            "PRISMA",
            "PRISMA-ScR",
            "CHEERS",
            "CARE",
            "SQUIRE",
            "ARRIVE"
          ]
        },
        "setting": {
          "type": "string",
          "enum": [
            "hospital_based",
            "community_based",
            "multicentre",
            "registry",
            "laboratory"
          ]
        },
        "centres": {
          "type": "integer"
        },
        "recruitment_period": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "population": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^grp_"
              },
              "label": {
                "type": "string"
              },
              "allocation_ratio": {
                "type": "string"
              }
            }
          }
        },
        "claim_strength": {
          "type": "string",
          "enum": [
            "descriptive",
            "association",
            "prediction",
            "accuracy",
            "causal"
          ]
        }
      }
    },
    "timepoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "order",
          "window"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tp_"
          },
          "label": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "window": {
            "type": "string"
          },
          "offset_days": {
            "type": "integer"
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "required": [
        "inclusion",
        "exclusion"
      ],
      "additionalProperties": false,
      "properties": {
        "inclusion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "criterion"
          }
        },
        "exclusion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "criterion"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^obj_"
          },
          "tier": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "exploratory"
            ]
          },
          "question": {
            "type": "string"
          },
          "outcome_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "$ownedBy": "OBJ02"
          },
          "comparison_type": {
            "type": "string",
            "enum": [
              "superiority",
              "non_inferiority",
              "equivalence",
              "none"
            ]
          },
          "margin": {
            "type": "string"
          },
          "estimand": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "treatment_condition": {
                "type": "string"
              },
              "population": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "intercurrent_event_strategy": {
                "type": "string",
                "enum": [
                  "treatment_policy",
                  "hypothetical",
                  "composite",
                  "while_on_treatment",
                  "principal_stratum"
                ]
              },
              "population_level_summary": {
                "type": "string"
              }
            },
            "$ownedBy": "OBJ05"
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tier",
          "definition",
          "instrument",
          "timepoint_id",
          "data_type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^out_"
          },
          "label": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "exploratory"
            ]
          },
          "definition": {
            "type": "string"
          },
          "instrument": {
            "type": "string"
          },
          "timepoint_id": {
            "type": "string"
          },
          "data_type": {
            "type": "string",
            "enum": [
              "continuous",
              "count",
              "binary",
              "ordinal",
              "nominal",
              "time_to_event",
              "date",
              "text"
            ]
          },
          "subtype": {
            "type": "string",
            "$ownedBy": "VAR14"
          },
          "unit": {
            "type": "string"
          },
          "summary_statistic": {
            "type": "string",
            "$ownedBy": "OUT06"
          },
          "domain": {
            "type": "string"
          },
          "source_variable_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "$ownedBy": "OUT07"
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "role",
          "data_type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^var_"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "outcome_source",
              "exposure",
              "covariate",
              "effect_modifier",
              "mediator",
              "collider",
              "precision",
              "stratifier",
              "derived",
              "administrative",
              "eligibility",
              "censoring",
              "matching"
            ]
          },
          "data_type": {
            "type": "string",
            "enum": [
              "continuous",
              "count",
              "binary",
              "ordinal",
              "nominal",
              "time_to_event",
              "date",
              "text"
            ]
          },
          "subtype": {
            "type": "string",
            "$ownedBy": "VAR14"
          },
          "unit": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_level": {
            "type": "string"
          },
          "definition_source": {
            "type": "string",
            "enum": [
              "protocol",
              "standard"
            ]
          },
          "definition_reference": {
            "type": "string"
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "derivation": {
            "type": "string"
          },
          "derivation_kind": {
            "type": "string",
            "enum": [
              "formula",
              "score",
              "band",
              "index"
            ]
          },
          "crf": {
            "type": "object",
            "required": [
              "section_id",
              "order",
              "field_type",
              "response"
            ],
            "additionalProperties": false,
            "properties": {
              "section_id": {
                "type": "string"
              },
              "order": {
                "type": "integer"
              },
              "field_type": {
                "type": "string",
                "enum": [
                  "number",
                  "date",
                  "single_select",
                  "multi_select",
                  "single_select_text",
                  "text"
                ]
              },
              "response": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mask": {
                "type": "string"
              },
              "export_note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective_id",
          "outcome_id",
          "unadjusted_test"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ana_"
          },
          "objective_id": {
            "type": "string"
          },
          "outcome_id": {
            "type": "string"
          },
          "unadjusted_test": {
            "type": "string"
          },
          "adjusted_model": {
            "type": "string"
          },
          "covariate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect_measure": {
            "type": "string"
          },
          "table_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paired": {
            "type": "boolean"
          },
          "ph_check": {
            "type": "string"
          },
          "override_justification": {
            "type": "string"
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "block",
          "title",
          "kind",
          "row_variable_ids",
          "columns"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tbl_"
          },
          "number": {
            "type": "integer"
          },
          "block": {
            "type": "string",
            "enum": [
              "descriptive",
              "primary",
              "secondary",
              "exploratory",
              "sensitivity"
            ]
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "descriptive",
              "comparative",
              "effect",
              "accuracy",
              "agreement",
              "flow"
            ]
          },
          "row_variable_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "test_applied": {
            "type": "string"
          },
          "reference_rows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "footnote": {
            "type": "string"
          }
        }
      }
    },
    "crf_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "order"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sec_"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "parent_id": {
            "type": "string"
          },
          "timepoint_id": {
            "type": "string"
          }
        }
      }
    },
    "sample_size": {
      "type": "object",
      "required": [
        "formula",
        "inputs",
        "alpha",
        "power",
        "n_total",
        "powered_outcome_id"
      ],
      "additionalProperties": false,
      "properties": {
        "formula": {
          "type": "string",
          "enum": [
            "single_proportion",
            "single_mean",
            "two_proportions",
            "two_means",
            "paired_means",
            "case_control_or",
            "correlation",
            "sensitivity_specificity",
            "time_to_event",
            "cluster_adjusted",
            "non_inferiority_means",
            "other"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "alpha": {
          "type": "number"
        },
        "power": {
          "type": "number"
        },
        "attrition": {
          "type": "number"
        },
        "n_per_group": {
          "type": "integer"
        },
        "n_total": {
          "type": "integer"
        },
        "powered_outcome_id": {
          "type": "string"
        }
      }
    },
    "populations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pop_"
          },
          "label": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "used_for": {
            "type": "string"
          }
        }
      }
    },
    "multiplicity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "method"
        ],
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sensitivity_analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "purpose",
          "method"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sen_"
          },
          "label": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        }
      }
    },
    "missing_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_mechanism": {
          "type": "string",
          "enum": [
            "MCAR",
            "MAR",
            "MNAR",
            "unknown"
          ]
        },
        "primary_method": {
          "type": "string"
        },
        "sensitivity_method": {
          "type": "string"
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^open_"
          },
          "question": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object"
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^elg_"
        },
        "text": {
          "type": "string"
        },
        "variable_id": {
          "type": "string"
        },
        "numeric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variable_id": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
